{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PlatformRelay/landingzone-for-ovhcloud/schemas/deployments.schema.json",
  "title": "Deployment manifest (stacks/deployments.yaml)",
  "description": "YAML in its JSON-compatible flow form, whole-line # comments allowed. The decoder in tools/internal/stacks also refuses duplicate keys and case variants, and enforces the cross-row rules of data-model.md (scope, slot, duplicate id and scope, composition, producers, shared state project), which a schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"type": "string", "const": "lz.platformrelay.dev/v1alpha1"},
    "kind": {"type": "string", "const": "Deployments"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["org", "forge", "stage_source", "state", "tenants", "instances"],
      "properties": {
        "scope": {"type": "string", "description": "platform when absent", "enum": ["platform", "tenant"]},
        "org": {"type": "string", "description": "naming discriminator, one naming segment", "pattern": "^[a-z][a-z0-9]{0,15}$"},
        "forge": {"type": "string", "description": "managed-in prefix", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?(/[A-Za-z0-9_-][A-Za-z0-9._-]*)+$"},
        "stage_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"type": "string", "description": "git is a schema seam that generation refuses", "enum": ["local", "git"]}
          }
        },
        "sandbox": {
          "type": "object",
          "description": "KD-1; absent outside the sandbox",
          "additionalProperties": false,
          "required": ["shared_state_project"],
          "properties": {
            "shared_state_project": {"type": "boolean"}
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project", "region", "endpoint"],
          "properties": {
            "project": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref"],
              "properties": {
                "ref": {"type": "string", "description": "LZ_PROJECT_ID_<REF> in account.env", "pattern": "^[A-Z][A-Z0-9_]{0,62}$"}
              }
            },
            "region": {"type": "string", "pattern": "^[a-z]+$"},
            "endpoint": {"type": "string", "pattern": "^https://[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"}
          }
        },
        "tenants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "environments"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9]{0,15}$"},
              "environments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "project", "regions"],
                  "properties": {
                    "name": {"type": "string", "pattern": "^[a-z][a-z0-9]{0,15}$"},
                    "project": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["mode", "ref"],
                      "properties": {
                        "mode": {"type": "string", "enum": ["adopt", "reference"]},
                        "ref": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,62}$"}
                      }
                    },
                    "regions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name"],
                        "properties": {
                          "name": {"type": "string", "pattern": "^[A-Z]+[0-9]+$"},
                          "network": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["cidr", "vlan_id"],
                            "properties": {
                              "cidr": {"type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"},
                              "vlan_id": {"type": "integer"}
                            }
                          }
                        }
                      }
                    },
                    "budget_alert": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["enabled"],
                      "properties": {"enabled": {"type": "boolean"}}
                    },
                    "quota_guard": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["enabled"],
                      "properties": {"enabled": {"type": "boolean"}}
                    }
                  }
                }
              }
            }
          }
        },
        "external": {
          "type": "array",
          "description": "tenant manifests only: platform instances read from their artefacts, never planned here",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "stage"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"},
              "stage": {"type": "string", "enum": ["account-admin", "bootstrap", "tenant-state", "account-governance", "account-fabric", "project", "project-network", "runtime", "observability"]},
              "tenant": {"type": "string", "pattern": "^[a-z][a-z0-9]{0,15}$"},
              "environment": {"type": "string", "pattern": "^[a-z][a-z0-9]{0,15}$"},
              "region": {"type": "string", "pattern": "^[A-Z]+[0-9]+$"},
              "slot": {"type": "string", "pattern": "^[a-z][a-z0-9]{0,15}$"}
            }
          }
        },
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "stage"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"},
              "stage": {"type": "string", "description": "account-admin, account-fabric and observability are reserved: refused with STAGE_NOT_IMPLEMENTED", "enum": ["account-admin", "bootstrap", "tenant-state", "account-governance", "account-fabric", "project", "project-network", "runtime", "observability"]},
              "tenant": {"type": "string", "pattern": "^[a-z][a-z0-9]{0,15}$"},
              "environment": {"type": "string", "pattern": "^[a-z][a-z0-9]{0,15}$"},
              "region": {"type": "string", "pattern": "^[A-Z]+[0-9]+$"},
              "slot": {"type": "string", "description": "runtime only", "pattern": "^[a-z][a-z0-9]{0,15}$"}
            }
          }
        }
      }
    }
  }
}
