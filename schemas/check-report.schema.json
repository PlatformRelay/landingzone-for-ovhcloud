{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PlatformRelay/ovh-landing-zone-accelerator/schemas/check-report.schema.json",
  "title": "Check report observation",
  "description": "One observation of a pinned `tofu test -json` run, produced by tools/internal/report. The status is pass only when no reason was found; upstream diagnostics are kept verbatim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "tool", "tool_version", "exit_code", "discovered", "passed", "failed", "errored", "skipped", "runs", "diagnostics", "cleanup", "reasons"],
  "properties": {
    "status": { "enum": ["pass", "fail"] },
    "tool": { "const": "tofu" },
    "tool_version": { "type": "string" },
    "exit_code": { "type": "integer" },
    "discovered": { "type": "integer", "minimum": 0 },
    "passed": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "errored": { "type": "integer", "minimum": 0 },
    "skipped": { "type": "integer", "minimum": 0 },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "name", "status"],
        "properties": {
          "file": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "summary", "raw"],
        "properties": {
          "severity": { "type": "string" },
          "summary": { "type": "string" },
          "detail": { "type": "string" },
          "file": { "type": "string", "description": "Test file of the run the diagnostic followed." },
          "run": { "type": "string", "description": "Run block the diagnostic followed." },
          "raw": { "type": "object", "description": "tofu's complete diagnostic object, including range, snippet, difference or address." }
        }
      }
    },
    "cleanup": {
      "type": "array",
      "description": "Resources tofu left in state, one per failed_resources entry of a test_cleanup event.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "run", "resource"],
        "properties": {
          "file": { "type": "string", "description": "The event's @testfile." },
          "run": { "type": "string", "description": "The event's @testrun." },
          "resource": { "type": "object", "description": "The failed_resources entry, verbatim." }
        }
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "enum": ["EMPTY_STREAM", "TRUNCATED_STREAM", "MALFORMED_STREAM", "INVALID_PAYLOAD", "LIFECYCLE_ORDER", "MISSING_VERSION", "MISSING_SUMMARY", "RUN_MISMATCH", "NONZERO_EXIT", "ZERO_TESTS", "SKIPPED_RUN", "TESTS_FAILED", "ERROR_DIAGNOSTIC", "CLEANUP_FAILED"]
      }
    }
  }
}
