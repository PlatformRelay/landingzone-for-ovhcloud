{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PlatformRelay/landingzone-for-ovhcloud/schemas/outputs/tenant-state.schema.json",
  "title": "tenant-state outputs",
  "description": "`values` of the tenant-state stage's outputs envelope (005 data-model *Per-stage values*). The tenant and platform S3 credentials stay sensitive and are never published.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant", "state_bucket", "tenant_s3_user_id", "platform_s3_user_id", "unlabelled"],
  "properties": {
    "tenant": { "type": "string", "minLength": 1 },
    "state_bucket": { "type": "string", "minLength": 1 },
    "tenant_s3_user_id": { "type": "string", "minLength": 1 },
    "platform_s3_user_id": { "type": "string", "minLength": 1 },
    "unlabelled": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
