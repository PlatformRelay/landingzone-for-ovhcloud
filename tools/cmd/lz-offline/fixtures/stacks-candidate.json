{
  "terramate.tm.hcl": "terramate {\n  required_version = \"0.17.3\"\n  config {\n    git {\n      default_branch = \"main\"\n    }\n  }\n}\n",
  "stacks/deployments.yaml": "{\n  \"apiVersion\": \"lz.platformrelay.dev/v1alpha1\",\n  \"kind\": \"Deployments\",\n  \"metadata\": {\"name\": \"fixture\"}\n}\n",
  "stacks/lz.tm.hcl": "import {\n  source = \"/stacks/_lz/*.tm.hcl\"\n}\n",
  "stacks/_lz/backend.tm.hcl": "generate_hcl \"_lz_backend.tf\" {\n  content {}\n}\n",
  "stacks/_lz/globals.tm.hcl": "globals \"lz\" {\n  stage = \"runtime\"\n}\n",
  "stacks/_lz/main.tm.hcl": "generate_hcl \"_lz_main.tf\" {\n  content {}\n}\n",
