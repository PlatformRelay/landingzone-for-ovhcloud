  "stacks/tenants/demo/dev/project/_lz_main.tf": "module \"project\" {\n  source = \"../../../../../stages/project\"\n}\n",
  "stacks/tenants/demo/dev/project/_lz_outputs.tf": "output \"project_id\" {\n  value = module.project.project_id\n}\n",
  "stacks/tenants/demo/dev/project/_lz_providers.tf": "provider \"ovh\" {}\n",
